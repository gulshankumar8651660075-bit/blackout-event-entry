{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run BLACKOUT (Fullstack)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal"
    },
    {
      "name": "Run Backend Only",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/backend",
      "program": "${workspaceFolder}/backend/src/server.js",
      "console": "integratedTerminal"
    }
  ]
}
